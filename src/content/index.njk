---
permalink: index.html
---

{% extends "layouts/base.njk" %}

{% block content %}

    {% set homepageProjects = collections.projects %}
    {% set homepageProjectSizes = "(min-width: 1024px) calc((100vw - 144px) / 2), calc(100vw - 52px)" %}

    <div class="section studio--container" id="studio">
        <div class="studio--content grid-layout">
            <p class="studio--location">Studio créatif belge<br>
            Liège — Bruxelles — Brabant wallon</p>
            <div class="studio--main grid-layout-5">
                <img class="studio--logo fluidimg" src="/assets/medias/svg/MateStudio_Logo-studio.svg" alt="Crok logo">
                <h4 class="studio--description">Nous concevons des expériences créatives complètes, en prenant en charge chaque étape, de l’idée à la réalisation. Avec moins de friction, plus de cohérence et plus de liberté créative.</h4>
            </div>
        </div>

    </div>

    <div class="section studio--projects grid-layout" id="projects">
        <div class="studio--projects-container">
            <div class="studio--projects-left">
                <div class="studio--projects-title">
                    <h1 class="">DERNIERS PROJETS</h1>
                    <h4 class="studio--projects-description">Could be yours</h4>
                </div>
                <ul class="studio--projects-list">
                    {% for project in homepageProjects %}
                        {% if loop.index0 < 1 %}
                            <li class="studio--projects-item">
                                <a href="{{ project.url }}">
                                    {% responsiveImage project.data.cover, "", homepageProjectSizes, "studio--projects-item-img fluidimg" %}
                                    <h5 class="studio--projects-item-title">{{project.data.title}}</h5>
                                    <p class="studio--projects-item-description">{{project.data.description}}</p>
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>

            </div>
            <div class="studio--projects-right">
                <ul class="studio--projects-list">
                    {% for project in homepageProjects %}
                        {% if loop.index0 >= 1 and loop.index0 < 3 %}
                            <li class="studio--projects-item">
                                <a href="{{ project.url }}">
                                    {% responsiveImage project.data.cover, "", homepageProjectSizes, "studio--projects-item-img fluidimg" %}
                                    <h5 class="studio--projects-item-title">{{project.data.title}}</h5>
                                    <p class="studio--projects-item-description">{{project.data.description}}</p>
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
                <a href="/projects.html" class="studio--projects-more">
                    <p class="cta">Voir tous les projets</p>
                </a>
            </div>
        </div>
    </div>

    <div class="section section--dark"></div>

    <div class="section section--dark grid-layout" id="services">
        <div class="studio--dark">
            <div class="studio--dark-title">
                <p>001</p>
                <h2>Services</h2>
            </div>
            <ul class="expertise--list">
                
                {% for service in collections.services %}
                
                    <li class="expertise--item grid-layout-5 grid-layout-desktop-9">
                        <input type="checkbox" id="expertise--{{ service.data.tag }}" class="expertise--item-input">
                        <label for="expertise--{{ service.data.tag }}" class="expertise--item-label">
                            <h4 class="expertise--name">{{ service.data.name }}</h4>
                        </label>
                        <div class="expertise--item-content grid-layout-desktop-9">
                            <div>
                                <p class="div expertise--item-text">{{ service.data.description }}</p>
                                <ul class="expertise--item-skills">
                                    {% for skill in service.data.skills %}
                                        <li><p>{{ skill }}</p></li>
                                    {% endfor %}
                                </ul>
                            </div>
                            <a href="/projects.html#{{ service.data.tag }}" class="expertise--item-cta">
                                <h3 class="cta">Voir des projets en lien</h3>
                            </a>
                        </div>
                    </li>

                {% endfor %}

            </ul>
        </div>

    </div>

    <div class="section section--dark grid-layout" id="process">
        <div class="studio--dark">
            <div class="studio--dark-title">
                <p>002</p>
                <h2>Processus</h2>
            </div>
            <div class="process--container grid-layout-5 grid-layout-desktop-9">
                <p class="process--text">Chaque projet avance avec une méthode claire, souple et collaborative. Nous cadrons les besoins, construisons une direction forte, puis nous produisons et déployons avec le même niveau d’exigence du début à la fin.</p>
                <div class="process--content grid-layout-desktop-9">
                    <ul class="process--steps">
                        <li class="process--step grid-layout-5 grid-layout-desktop-4">
                            <h5 class="process--step-number">1</h5>
                            <div class="process--step-content">
                                <h5 class="process--step-title">Découverte</h5>
                                <p class="process--step-description">Nous échangeons pour comprendre votre contexte, vos objectifs, vos contraintes et la réalité du projet.</p>
                            </div>
                        </li>
                        <li class="process--step grid-layout-5 grid-layout-desktop-4">
                            <h5 class="process--step-number">2</h5>
                            <div class="process--step-content">
                                <h5 class="process--step-title">Cadrage</h5>
                                <p class="process--step-description">Nous définissons les priorités, le périmètre, les livrables et le bon niveau d’ambition pour avancer efficacement.</p>
                            </div>
                        </li>
                        <li class="process--step grid-layout-5 grid-layout-desktop-4">
                            <h5 class="process--step-number">3</h5>
                            <div class="process--step-content">
                                <h5 class="process--step-title">Direction créative</h5>
                                <p class="process--step-description">Nous posons une intention visuelle et narrative forte pour garantir cohérence, impact et singularité.</p>
                            </div>
                        </li>
                    </ul>
                    <ul class="process--steps">
                        <li class="process--step grid-layout-5 grid-layout-desktop-4">
                            <h5 class="process--step-number">4</h5>
                            <div class="process--step-content">
                                <h5 class="process--step-title">Production</h5>
                                <p class="process--step-description">Nous réalisons les contenus, les supports et les dispositifs avec précision, rythme et attention au détail.</p>
                            </div>
                        </li>
                        <li class="process--step grid-layout-5 grid-layout-desktop-4">
                            <h5 class="process--step-number">5</h5>
                            <div class="process--step-content">
                                <h5 class="process--step-title">Déploiement</h5>
                                <p class="process--step-description">Nous mettons en place les livrables sur les bons canaux pour assurer une mise en ligne ou une diffusion fluide.</p>
                            </div>
                        </li>
                        <li class="process--step grid-layout-5 grid-layout-desktop-4">
                            <h5 class="process--step-number">6</h5>
                            <div class="process--step-content">
                                <h5 class="process--step-title">Suivi</h5>
                                <p class="process--step-description">Nous restons présents pour ajuster, faire évoluer et consolider le projet après sa mise en circulation.</p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--dark grid-layout" id="vision">
        <div class="studio--dark">
            <div class="studio--dark-title">
                <p>003</p>
                <h2>Vision</h2>
            </div>
            <div class="vision--container grid-layout-5 grid-layout-desktop-9">
                <p class="vision--text">Notre vision : réunir nos regards, nos compétences et notre expertise pour créer des projets cohérents, de l’idée jusqu’au résultat final. Quatres visions, une même envie : donner forme à des univers créatifs complets qui ont de l’impact.</p>
                <div class="vision--content">
                    {% for collaborator in collections.collaborators %}
                        <div class="vision--person" style="background-image: {% responsiveBackground collaborator.data.profilePicture %};">
                            <h5 class="vision--person-name">{{collaborator.data.name}}</h5>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>


{% endblock %}
